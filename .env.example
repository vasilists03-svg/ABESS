# ABESS environment configuration
# Copy to .env and provide appropriate values.
# Never commit the real .env file.

# Authentication
# SECRET_KEY=
# ALGORITHM=
# ACCESS_TOKEN_EXPIRE_MINUTES=

# Personal API keys
# API_KEY_ENCRYPTION_KEY=
# API_KEY_HASH_SECRET=

# Database
# DATABASE_URL=

# rAIson integration
# RAISON_API_KEY=
# RAISON_APP_ID=
# RAISON_VERSION=
# RAISON_TIMEOUT_SECONDS=
# RAISON_METADATA_CACHE_SECONDS=

# Email service
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

# URLs
# BACKEND_URL=
# FRONTEND_URL=
# PUBLIC_BASE_URL=

# Administration
# ADMIN_EMAIL=

# Guest access
# GUEST_SOLVE_LIMIT=
